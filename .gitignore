__pycache__/
.ipynb_checkpoints/
*.py[cod]
.env
.venv/
dist/
build/
*.egg-info/

# Generated experiment artifacts are large and machine-specific.
# Keep source prompt/handoff metadata in data/prompts, but keep images,
# eval outputs, raw trajectories, SFT exports, logs, and API traces out of Git.
data/**
!data/
!data/.gitkeep
!data/prompts/
!data/prompts/**
!data/exchange/
!data/exchange/**
!data/failed/
!data/failed/.gitkeep
!data/images/
!data/images/.gitkeep
!data/processed/
!data/processed/.gitkeep
!data/raw/
!data/raw/.gitkeep
!data/sft/
!data/sft/.gitkeep

data/api_logs/
data/failed/collector_errors.jsonl
data/**/*.bmp
data/**/*.gif
data/**/*.jpeg
data/**/*.jpg
data/**/*.png
data/**/*.tif
data/**/*.tiff
data/**/*.webp
Gen-Searcher/
GenEvolve/
gen-searcher/
gen-evolve/
